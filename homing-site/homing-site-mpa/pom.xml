<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.captainssingapura-hue.homing.js</groupId>
        <artifactId>homing-site</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>
    <artifactId>homing-site-mpa</artifactId>
    <description>
        The MPA's DEFINITIONS: what a multi-page app is to a site - Mpa, the
        one declaration of brand, themes and crates that makes a JS app a
        page and mounts the framework's routes beside the site's own - the
        Brand on its bar, and the /themes route the preferences read.
        The implementation - StandardMpa, its page, its chrome and the
        preferences the chrome opens - is homing-site-mpa-standard, in the
        homing-ssjs-ui-components repo, because the chrome is built of the
        dialog and the preferences components. Core defines; it does not
        depend on a component. Depends on homing-site-base, homing-server,
        homing-core-js and homing-design-core, and knows nothing of trees.
    </description>
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-base</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-server</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-core-js</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-design-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
