# The sketch, and more: the plain button's own corner, a corner for Cancel on any button, the
# danger button's own treatment when disabled. The tree is the same; the walk finds the more
# precise answers where they are.
root               rest      shape-corner
root               rest      color-surface
root               rest      color-ink
button             rest      shape-corner
danger-button      rest      shape-corner
plain-button       rest      shape-corner
button_cancel      rest      shape-corner
danger-button_go   rest      color-surface
button_committing  rest      color-ink
floating-pane      rest      color-surface
root               disabled  effect-opacity
button             disabled  color-surface
danger-button      disabled  color-surface
