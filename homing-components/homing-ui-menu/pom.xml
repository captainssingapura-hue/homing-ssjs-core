        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-ui-menu</artifactId>
    <description>
        Context menus: a menu is a type declared once in a registry, an object
        is bound to the type's one instance while it is open, and one lazy
        steward per page owns the registry, the instances, the layer and the
        single fundamental invariant - at most one context menu active on a
        page. RFC 0066 Episode 3, appendix Context Menus.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

