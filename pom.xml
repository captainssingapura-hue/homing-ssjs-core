<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.captainssingapura-hue.homing.js</groupId>
    <artifactId>homing.js</artifactId>
    <version>LOCAL-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>homing-core</module>
        <module>homing-core-js</module>
        <!-- RFC 0066 Episode 3, layer 1 — the component base: the headless
             runtime every DOM-level component is built on, moved out of
             homing-server file for file, its package kept until the old
             structure retires. -->
        <module>homing-component-base</module>
        <module>homing-server</module>
        <module>homing-libs</module>
        <!-- RFC 0065 layer 3 / RFC 0066 — the theme design core, one sub-module per
             design vocabulary; colour first. -->
        <module>homing-theme-design</module>
        <!-- RFC 0066 Episode 3, layer 4 — the site base: Navigable, Router,
             Site and the host that serves one, plus the nested demo modules
             that prove the contract on the base alone. -->
        <module>homing-site</module>
        <!-- RFC 0066 Episode 3, layer 2 — the DOM-level components — live in a
             repo of their own now, homing-ssjs-ui-components, moved with their
             history. Same coordinates; they build after core. -->
        <!-- The Meta-Function ontology — four typed interfaces naming the
             objects involved in code-generated codecs (ObjectDefinition,
             TransformationFunctions, FunctionsCodeGen, DefinitionCodeGen).
             Leaf module (no internal deps); implementations live with
             their Value Objects in downstream modules. -->
        <module>homing-codec</module>
        <!-- Concrete ECMAScript-target implementations of the homing-codec
             ontology — EcmaDefinitionCodeGen + EcmaFunctionsCodeGen. Stateless
             Functional Objects; same code runs at build time (Maven exec in a
             consumer module) and could run at request time if needed. -->
        <module>homing-codec-ecma</module>
        <!-- Concrete Java-target implementation of the homing-codec ontology —
             JavaFunctionsCodeGen emits a Java TransformationFunctions (JSON
             codec) for a record ObjectDefinition. Sibling to homing-codec-ecma;
             the host-language target (no DefinitionCodeGen — the record is the
             type). -->
        <module>homing-codec-java</module>
        <!-- Rigid tree substrate — typed leveled TreeNode value objects +
             canonical JSON serialiser. Substrate for "any tree renders on
             JS without a single line of JS code". Downstream modules supply
             per-tree-kind adapter records mapping native shapes (catalogues,
             ComposedDoc segments, etc.) to TreeNode<L>; the JS renderer (in
             homing-core-js, alongside DomOpsParty) consumes the JSON without
             knowing the source tree-kind. Borrows DomOpsParty's leveled-types
             pattern (L0..L8 sealed sum). Depends only on homing-codec. -->
        <!-- homing-rigid-tree (RFC 0040): the substrate-free definition +
             arithmetic of the normalized rigid tree (TreeLevel L0..L18 +
             atDepth/shifted, NormalizedNode, graft/shift). Zero framework
             deps. tree-views (serialization) + the studio normalizers depend
             ON it; builds first. -->
        <module>homing-rigid-tree</module>
        <module>homing-doc-model</module>
        <module>homing-plan-model</module>
        <module>homing-svg-doc</module>
        <module>homing-tree-views</module>
        <module>homing-conformance-rules</module>
        <module>homing-conformance-engine</module>
        <!-- Phase 8 polyglot report codec. -gen holds the managed Functions (the
             ReportCodecManifest + ReportCodecGen driver); -codec is output-only,
             hosting nothing but the generated Java codec (target/generated-sources,
             never committed) that downstream export + ResultSource depend on. -->
        <module>homing-conformance-report-gen</module>
        <module>homing-conformance-report-codec</module>
        <!-- Report I/O: assemble (engine) → write via the generated codec →
             read back through the ResultSource. Depends on engine + report-codec. -->
        <module>homing-conformance-export</module>
        <!-- Core's own conformance: the gate, and the report exported into its jar for the
             studio repo's studio (8090) to show. Headless. -->
        <module>homing-conformance-self</module>
        <!-- Pure-JS test fixtures (GraalVM Polyglot + JUnit harness). Lives
             at the substrate position so japjs's own tests and every
             downstream consumer (homing-demo, homing-self-studio, public
             projects) can depend on it as an ordinary Maven artifact —
             no test-jar classifier ceremony. -->
        <module>homing-ssjs-test-fixtures</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <ja-http.version>0.1.0</ja-http.version>
        <junit.version>5.11.3</junit.version>
        <jacoco.version>0.8.14</jacoco.version>
        <!-- RFC 0028 cycle 6 phase 2 — GraalVM Polyglot for JS Secretary testing. -->
        <graalvm.version>24.1.1</graalvm.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
